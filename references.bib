  year          = {2023},
  eprint        = {2305.01428},
  archivePrefix = {arXiv},
  primaryClass  = {math.PR},
}

% Proves TW beta=1 edge universality for uniform simple d-regular graphs
% (any fixed d >= 3) with explicit constants A = d(d-1)/(d-2)^2 and NO
% shift; one-sided P(Ramanujan) -> F_1(0) ~ 83%, two-sided -> F_1(0)^2 ~ 69%
% via proven asymptotic independence. Still an arXiv preprint as of 2026-07.
@misc{HuangMcKenzieYau2024,
